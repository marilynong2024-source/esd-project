# Copy to `.env` in the project root (same folder as docker-compose.yml).
# Docker Compose loads this file automatically for ${VAR} substitution.
# Do not commit `.env` if it contains secrets (SMU API key, etc.).

# ---------------------------------------------------------------------------
# Optional: skip Flight/Hotel HTTP checks on POST /booking (default is to validate)
# SKIP_CATALOG_VALIDATION=false

# ---------------------------------------------------------------------------
# MySQL (Booking service) — defaults match docker-compose booking-db service
# ---------------------------------------------------------------------------
BOOKING_DB_URL=mysql+pymysql://travel_user:travel_pass@booking-db:3306/travel_booking

# Optional: override MySQL container credentials (must match booking-db service)
# MYSQL_ROOT_PASSWORD=root
# MYSQL_DATABASE=travel_booking
# MYSQL_USER=travel_user
# MYSQL_PASSWORD=travel_pass

# ---------------------------------------------------------------------------
# OutSystems — Traveller Profile (teammate-owned REST). Routes + Create body: travellerprofile/outsystems_client.py
# ---------------------------------------------------------------------------
# Explicit base URL (recommended in Docker). Comment out to use the hard-coded default in code.
TRAVELLER_PROFILE_BASE_URL=https://personal-zhhppbon.outsystemscloud.com/TravellerProfileService/rest/TravellerProfileAPI
# false = real OutSystems HTTP. true = in-memory demo travellers (offline / no cloud).
TRAVELLER_PROFILE_LOCAL_DEMO=false
# If true, a missing/invalid profile ID fails the booking when URL is set
TRAVELLER_PROFILE_REQUIRED=false

# ---------------------------------------------------------------------------
# External FX (booking service)
# ---------------------------------------------------------------------------
# ExchangeRate-API (recommended): get a key at https://app.exchangerate-api.com/dashboard
# → used for UI “Prices in” (GET /booking/fx-rate) via v6 API, and for booking FX snapshot when enabled below.
EXCHANGE_RATE_API_KEY=
# Optional alias if you prefer this name:
# EXCHANGERATE_API_KEY=

# Snapshot JSON on create-booking when true. With EXCHANGE_RATE_API_KEY set, uses the same v6 API; else Frankfurter.
FX_API_ENABLED=false
# Optional: force a specific snapshot URL (overrides v6 / Frankfurter default).
# FX_API_URL=https://api.frankfurter.app/latest?from=SGD&to=USD,EUR

# ---------------------------------------------------------------------------
# Optional: SMU / OutSystems notification REST (notification/smu_integration.py)
# ---------------------------------------------------------------------------
# SMU_NOTIFICATION_ENABLED=false
# SMU_NOTIFICATION_BASE_URL=https://smuedu-dev.outsystemsenterprise.com/.../rest/Notification
# SMU_NOTIFICATION_AUTH_HEADER=Authorization
# SMU_NOTIFICATION_AUTH_VALUE=
# SMU_NOTIFY_EMAIL_TO=

# ---------------------------------------------------------------------------
# Twilio — SMS (notification service after RabbitMQ)
# ---------------------------------------------------------------------------
# Configure via .env (below) and/or UI → POST /api/notification/twilio/config (persists in volume).
# TWILIO_ENABLED=false
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15551234567
# Optional demo fallback when booking form has no mobile (trial verified destination):
# TWILIO_TO_NUMBER=+6591234567

# ---------------------------------------------------------------------------
# Aviationstack — live flight status (flight service, optional enrichment)
# ---------------------------------------------------------------------------
# Set AVIATIONSTACK_ENABLED=true and API key. Catalog/pricing stay in-memory; add ?live=1 to
# GET /flight/{flightNum} for aviationstackLive on the payload. Health: GET /integrations/health
# AVIATIONSTACK_API_KEY=
# AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
# AVIATIONSTACK_ENABLED=false
